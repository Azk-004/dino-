# Copier ce fichier vers .env et renseigner les valeurs du projet Supabase
# (Dashboard Supabase → Settings → API).
#
# Les tables (page_visits, lesson_reads, quiz_results, contact_messages) doivent
# être créées une fois dans le projet : exécuter supabase/schema.sql dans le
# Dashboard → SQL Editor.

VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=cle_anon_publique_du_projet
