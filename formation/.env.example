# Copier ce fichier vers .env et renseigner les valeurs de ton projet Supabase
# (Dashboard Supabase → Settings → API).
#
# Ces deux variables sont nécessaires au build du frontend (connexion obligatoire
# avant d'accéder aux leçons). Elles doivent aussi être déclarées sur l'hébergeur
# (Netlify → Site settings → Environment variables).

SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_ANON_KEY=cle_publishable_du_projet

# Secrets du backend (Edge Function `login-code`) - à définir sur Supabase :
#   npx supabase secrets set RESEND_API_KEY="re_..."
#   npx supabase secrets set RESEND_FROM="Panneautique <no-reply@votre-domaine.site>"
# Ne jamais mettre ces secrets dans un fichier commité ni dans le frontend.
